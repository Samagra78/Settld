# Copy to .env and fill in. Never commit .env.
PORT=3000
ARC_RPC_URL=https://rpc.testnet.arc.network
# Circle user-controlled wallets (console.circle.com -> Keys / Wallets -> User Controlled)
CIRCLE_API_KEY=
CIRCLE_APP_ID=
# Optional read-only demo wallet route for local development.
# NODE_ENV=development
CIRCLE_BRAND_WALLET_ID=
CIRCLE_CREATOR_WALLET_ID=
# Optional Arc Testnet ClauseEscrow override. Defaults to shared/addresses.json.
ESCROW_ADDRESS=
# Enable the testnet WF0 CLI trigger after configuring CRE in cre/.env.
CRE_CERTIFY_ENABLED=false
# Optional path to the CRE executable when it is not on PATH.
CRE_BINARY=
# Test-only wallet that funds the mock "Add funds" button. Fund it at faucet.circle.com. Never use on mainnet.
TREASURY_PRIVATE_KEY=
# ---- World ID + jury (V1c) ----
# JurorRegistry on Arc testnet
JUROR_REGISTRY_ADDRESS=
# Test-only key that signs World ID attestations. Its ADDRESS is baked into JurorRegistry at deploy.
ATTESTER_PRIVATE_KEY=
# From developer.world.org (keep the signing key secret: it is shown once)
WLD_APP_ID=
WLD_RP_ID=
WLD_RP_SIGNING_KEY=
WLD_ACTION=settld-member
# staging = World ID Simulator (simulator.worldcoin.org), production = World App
WLD_ENVIRONMENT=staging
# Shared secret WF3 uses to store AI court transcripts (same value as COURT_WRITE_TOKEN_ALL in cre/.env)
COURT_WRITE_TOKEN=
# How much the mock "Add funds" button sends (test USDC). Sends what is left if the treasury has less.
TOP_UP_USDC=10
# ---- Automation (watcher + keeper) ----
# Auto-run Chainlink workflows on chain events and settle money without clicks
AUTOMATION_ENABLED=false
# Funded TEST wallet that sends the keeper transactions (release, refund, closeCase, finalize...)
KEEPER_PRIVATE_KEY=
# WF3 target: production-settings = live AI judges, staging-settings = scripted replay
WF3_TARGET=production-settings
WATCH_INTERVAL_MS=4000
KEEPER_INTERVAL_MS=30000
